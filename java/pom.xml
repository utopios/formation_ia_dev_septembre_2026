<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.utopios.formation</groupId>
    <artifactId>formation-ia</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Formation IA Generative - socle Java</name>
    <description>Socle Java des demos et TP de la formation IA Generative (Utopios)</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.cleanupDaemonThreads>false</exec.cleanupDaemonThreads>
    </properties>

    <dependencies>
        <!-- Serialisation / deserialisation JSON (appels HTTP vers Ollama) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <!-- 2.22.2 : version exigee par copilot-sdk-java (Demo 15).
                 Maven applique « nearest wins » : si le projet declarait
                 2.19.0, c'est elle qui l'emporterait sur celle du SDK. -->
            <version>2.22.2</version>
        </dependency>

        <!-- LangChain4j : abstraction de haut niveau (utilisee pour le RAG) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <version>1.0.0-beta5</version>
        </dependency>
        <!-- Magasin pgvector de LangChain4j : RAG 02b, variante 3 — le meme code
             que le magasin en memoire, sur la base de la formation. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-pgvector</artifactId>
            <version>1.0.0-beta5</version>
        </dependency>

        <!-- Pilote JDBC PostgreSQL : demo 7 (pgvector). Le type "vector" se
             manipule en texte via un cast ::vector, donc aucun pilote
             specialise n'est necessaire. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>

        <!-- SDK GitHub Copilot : Demo 15, piloter un agent outille depuis
             Java et suivre sa boucle. Toutes les versions publiees sont en
             -preview : l'API peut bouger, la fiche de demo le dit. Le SDK
             n'embarque PAS le CLI 'copilot', qui s'installe a part
             (npm install -g @github/copilot). -->
        <dependency>
            <groupId>com.github</groupId>
            <artifactId>copilot-sdk-java</artifactId>
            <version>1.0.15-preview.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Version explicite : le plugin par defaut de Maven 3.8 (3.1)
                 ne comprend pas maven.compiler.release -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Conserve les noms de parametres dans le bytecode : LangChain4j
                         (Demo 3c) les lit pour nommer les arguments des outils
                         (« chemin » plutot que « arg0 »). -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- Permet de lancer une classe main par une seule commande :
                 mvn -q compile exec:java -Dexec.mainClass="fr.utopios.formation.commun.SmokeTest" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <!-- Recopie les dependances dans target/dependances au moment du
                 package. Utilise uniquement par le Containerfile des demos
                 10 et 11, qui construit un classpath sans Maven dans l'image
                 finale (JRE seul). Sans effet sur les lancements locaux. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copier-dependances</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependances</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
