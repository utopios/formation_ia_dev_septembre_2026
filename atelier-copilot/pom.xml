<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.novatech</groupId>
  <artifactId>orders-api</artifactId>
  <version>2.4.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>orders-api</name>
  <description>
    Coeur du tunnel de commande B2B NovaTech Industries : panier, bareme de
    remise, validation hierarchique, transmission a la facturation.
  </description>

  <!--
    Note d'atelier (formation) : le projet de production est un Spring Boot
    3.3. Cette copie de travail est volontairement reduite a du Java standard
    afin que le build tienne en quelques secondes sans resoudre tout
    l'ecosysteme Spring. Les classes des couches web et infrastructure miment
    la structure reelle sous forme de POJO : memes noms, memes signatures,
    memes responsabilites, sans conteneur d'injection ni pilote JDBC.
    Le code du domaine, lui, est celui de production : il ne depend d'aucun
    framework, conformement a la norme d'architecture de l'equipe.
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <assertj.version>3.25.3</assertj.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
